#include <iostream>
#include <string>
using namespace std;

class Display
{
public:
    void print(string s);
    void print(int n);
};

void Display::print(string s)
{
    cout << "String: " << s << endl;
}

void Display::print(int n)
{
    cout << "Integer: " << n << endl;
}

int main()
{
    Display d;

    d.print("Hello");
    d.print(100);

    return 0;
}
