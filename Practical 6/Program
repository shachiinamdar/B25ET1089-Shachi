#include <iostream>
using namespace std;

class Complex  //class named complex is created
{
    float real, imag;  //declares two data members
    public:  //can be accessed outside class
    Complex(float r, float i)  //constructor
    {
    real=r;  //stores real part in r
    imag=i;  //stores imaginary part in i
}

Complex operator*(float scalar)  //operator overloading function
{
    return Complex(real*scalar, imag*scalar);  //multiplication
    
}
void display()  //displays complex no.
{
    cout<<real<<"+"<<imag<<"i";  //prints complex number in a+ib form
    
}
};


int main()  //where execution of program begins
{
    Complex c1(3, 4);  //creates object c1
    float scalar=2;  //creates variable scalar and stores 2 in it
    Complex result=c1*scalar;  //where overload* operator is used
    cout<<"Result=";  //prints result=
    result.display();  //calls display function of result

    return 0;  //program executed successfully.
}
    
